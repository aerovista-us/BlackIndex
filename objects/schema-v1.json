{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackindex.aerovista.us/schema/evidence-map-object-v1.json",
  "title": "BlackIndex Evidence-Map Object v1",
  "type": "object",
  "required": ["schema_version", "object_type", "object_id"],
  "properties": {
    "schema_version": {"const": 1},
    "object_type": {
      "enum": [
        "record_integrity",
        "missing_evidence",
        "version_family",
        "version_comparison",
        "source_dependency",
        "statement_comparison",
        "investigator_review"
      ]
    },
    "object_id": {"type": "string", "minLength": 1},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "doc_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"object_type": {"const": "record_integrity"}}},
      "then": {
        "required": ["doc_id", "completeness", "redaction_concern", "known_destruction", "missing_referenced_records", "archive_confidence"],
        "properties": {
          "completeness": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "redaction_concern": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
          "archive_confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "known_destruction": {"type": ["string", "boolean", "null"]},
          "missing_referenced_records": {"type": "array"}
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "missing_evidence"}}},
      "then": {
        "required": ["doc_id", "category", "summary", "status"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "version_family"}}},
      "then": {
        "required": ["title", "doc_ids"],
        "properties": {"doc_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "version_comparison"}}},
      "then": {
        "required": ["left_doc_id", "right_doc_id", "similarity_ratio", "diff_line_count"],
        "properties": {
          "similarity_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "diff_line_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "source_dependency"}}},
      "then": {
        "required": ["assertion_id", "source_id", "depends_on", "dependency_type", "independence"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "string", "minLength": 1},
          "dependency_type": {"type": "string", "minLength": 1},
          "independence": {"enum": ["independent", "partially-independent", "dependent", "unknown"]}
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "statement_comparison"}}},
      "then": {
        "required": ["topic", "public_source", "public_statement", "internal_source", "internal_content", "relationship"]
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "investigator_review"}}},
      "then": {
        "required": ["report_or_finding", "investigator", "exact_wording", "scope", "conclusion_adopted_as_fact"],
        "properties": {
          "conclusion_adopted_as_fact": {"const": false},
          "investigator_independence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "access_to_evidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "method_transparency": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "reproducibility": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "conflict_exposure": {"type": ["integer", "null"], "minimum": 0, "maximum": 5}
        }
      }
    }
  ],
  "additionalProperties": true
}
