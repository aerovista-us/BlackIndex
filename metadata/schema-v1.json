{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackindex.aerovista.us/schema/metadata-v1.json",
  "title": "BlackIndex Document Metadata v1",
  "description": "Backward-compatible BlackIndex document metadata. New evidence-map and record-integrity fields are optional so previously ingested records remain valid.",
  "type": "object",
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "source",
    "collection",
    "retrieved_at",
    "local_raw_path",
    "size_bytes",
    "sha256",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "doc_id": {"type": "string", "pattern": "^[A-Z0-9_-]+-(?:[0-9]{4}|undated)-[a-z0-9-]+-[0-9]{3,}$"},
    "call_id": {"type": ["string", "null"]},
    "native_id": {"type": ["string", "null"]},
    "record_group": {"type": ["string", "null"]},
    "series": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 2},
    "originating_agency": {"type": ["string", "null"]},
    "collection": {"type": "string", "minLength": 1},
    "document_type": {"type": ["string", "null"]},
    "document_date": {"type": ["string", "null"]},
    "date_created": {"type": ["string", "null"]},
    "date_declassified": {"type": ["string", "null"]},
    "date_publicly_released": {"type": ["string", "null"]},
    "year_bucket": {"type": "string"},

    "source_url": {"type": ["string", "null"]},
    "canonical_landing_url": {"type": ["string", "null"]},
    "artifact_url": {"type": ["string", "null"]},
    "archive_location": {"type": ["string", "null"]},
    "artifact_type": {"type": ["string", "null"]},
    "record_creator": {"type": ["string", "null"]},
    "record_custodian": {"type": ["string", "null"]},
    "declassification_authority": {"type": ["string", "null"]},
    "withholding_authority": {"type": ["string", "null"]},
    "chain_of_custody": {"type": ["string", "array", "null"], "items": {"type": "string"}},
    "document_integrity": {"type": ["string", "object", "null"]},

    "retrieved_at": {"type": "string"},
    "original_filename": {"type": "string"},
    "local_raw_path": {"type": "string", "minLength": 1},
    "normalized_text_path": {"type": ["string", "null"]},
    "normalization_status": {"type": ["string", "null"]},
    "normalized_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "normalized_at": {"type": ["string", "null"]},
    "mime_hint": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},

    "classification_original": {"type": ["string", "null"]},
    "classification_note": {"type": ["string", "null"]},
    "classification_chronology": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "release_chronology": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "exemption_codes": {"type": ["array", "null"], "items": {"type": "string"}},
    "alternate_versions": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "version_relationships": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},

    "people": {"type": ["array", "null"], "items": {"type": "string"}},
    "organizations": {"type": ["array", "null"], "items": {"type": "string"}},
    "operations": {"type": ["array", "null"], "items": {"type": "string"}},
    "locations": {"type": ["array", "null"], "items": {"type": "string"}},
    "related_documents": {"type": ["array", "null"], "items": {"type": "string"}},
    "source_dependencies": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},

    "known_missing_material": {"type": ["array", "string", "null"], "items": {"type": ["string", "object"]}},
    "missing_referenced_records": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "known_destruction": {"type": ["boolean", "string", "null"]},
    "destruction_chronology": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "custodian_conflicts": {"type": ["boolean", "array", "null"], "items": {"type": ["string", "object"]}},
    "version_conflicts": {"type": ["boolean", "array", "null"], "items": {"type": ["string", "object"]}},
    "public_internal_contradictions": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},

    "redaction_note": {"type": ["string", "null"]},
    "redaction_count": {"type": ["integer", "null"], "minimum": 0},
    "redaction_density": {"type": ["number", "string", "null"]},
    "critical_redactions": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},
    "redaction_impact": {"type": ["number", "string", "object", "null"]},
    "redaction_clusters": {"type": ["array", "null"], "items": {"type": ["string", "object"]}},

    "primary_document": {"type": ["string", "object", "null"]},
    "official_interpretation": {"type": ["array", "string", "object", "null"], "items": {"type": ["string", "object"]}},
    "independent_analysis": {"type": ["array", "string", "object", "null"], "items": {"type": ["string", "object"]}},

    "state_of_record": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5", null]},
    "plausibility_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
    "evidence_density_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 30},
    "obstruction_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 20},
    "archive_confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "source_confidence": {"type": ["array", "object", "string", "null"]},
    "inference_dependency": {"enum": ["D0", "D1", "D2", "D3", "D4", null]},

    "investigator_independence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "access_to_evidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "method_transparency": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "reproducibility": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "conflict_exposure": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},

    "tags": {"type": "array", "items": {"type": "string"}},
    "evidence_status": {"enum": ["unreviewed", "reviewed", "corroborated", "contested", "retired"]}
  },
  "additionalProperties": true
}
